#!/bin/sh
chmod 755 /usr/libexec/auxcamd
chmod 644 /Library/LaunchDaemons/com.auxcam.daemon.plist
# 守护进程的工作目录必须存在，否则 launchd 直接失败（状态码 78）
mkdir -p /var/mobile/Media/DCIM
chown mobile:mobile /var/mobile/Media/DCIM
chmod 755 /var/mobile/Media/DCIM
# 装完立刻拉起，不用重启；开机由 RunAtLoad 自动起来
launchctl unload /Library/LaunchDaemons/com.auxcam.daemon.plist 2>/dev/null || true
launchctl load -w /Library/LaunchDaemons/com.auxcam.daemon.plist 2>/dev/null || true
exit 0
